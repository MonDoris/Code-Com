# Keep LF everywhere: bash scripts break with CRLF, and public/tide_dpop_auth.html is pinned by
# sha256 hashes in its Content-Security-Policy, so any newline change breaks Tide DPoP.
* text=auto eol=lf
safesignal/public/tide_dpop_auth.html -text
*.png binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
